{
  "opencollection": "1.0.0",
  "info": {
    "name": "Outline AccessRequests Auth API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve auth",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.getoutline.com/api/auth.info"
          },
          "docs": "Retrieve authentication details for the current API key"
        },
        {
          "info": {
            "name": "Retrieve auth config",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.getoutline.com/api/auth.config"
          },
          "docs": "Retrieve authentication options"
        }
      ]
    }
  ],
  "bundled": true
}