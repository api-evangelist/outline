{
  "opencollection": "1.0.0",
  "info": {
    "name": "Outline AccessRequests Events API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
